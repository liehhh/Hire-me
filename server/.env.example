PORT=4001
CLIENT_ORIGIN=http://localhost:5173

# Gemini is called only from this server; the key never reaches the browser.
GEMINI_API_KEY=your-gemini-api-key-here
# Must be a model that can generate on your key's tier. Note: gemini-2.5-flash
# returns 404 for API keys created after its retirement — the server fails at
# startup with a clear message in that case. gemini-3.1-flash-lite works on
# the free tier at the time of writing.
GEMINI_MODEL=gemini-2.5-flash
# Used on retries when the primary model returns 503 (overloaded). Empty disables.
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# The interviewer's voice (Amazon Polly). Locally this needs AWS credentials
# (e.g. AWS_PROFILE) and a region (AWS_REGION).
# TTS_ENABLED=true
# POLLY_VOICE=Joanna
# POLLY_ENGINE=neural           # neural | generative
# TTS_CHARS_PER_DAY=50000       # Lambda only; 0 = no cap

# Optional tuning (defaults shown)
# GEMINI_THINKING=auto          # auto | off
# GEMINI_STARTUP_CHECK=true     # one 1-token request at boot to verify the model
# GEMINI_RPM=8                  # process-wide requests/minute (keep under your free-tier RPM)
# GEMINI_RPD=0                  # process-wide requests/day, 0 = no local cap
# GEMINI_TIMEOUT_MS=20000
# GEMINI_REPORT_TIMEOUT_MS=10000
# REPORT_MAX_OUTPUT_TOKENS=8192
# MAX_QUESTIONS=30
# MAX_INTERVIEW_MINUTES=90
